---
import BaseLayout from './BaseLayout.astro';

interface Props {
  id: string;
  moduleNumber: number;
  title: string;
  description: string;
  duration?: string;
  prevModule?: { id: string; title: string } | null;
  nextModule?: { id: string; title: string } | null;
}

const {
  id,
  moduleNumber,
  title,
  description,
  duration = '45 min',
  prevModule,
  nextModule,
} = Astro.props;
---

<BaseLayout title={`${title} | OVA n8n`} description={description}>
  <article class="max-w-4xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-8 lg:py-12 flex-grow">
    <!-- Breadcrumb & Tag -->
    <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
      <nav class="flex items-center gap-2 text-xs font-medium text-slate-400">
        <a href="/" class="hover:text-n8n transition-colors">Inicio</a>
        <span>/</span>
        <span class="text-slate-200">Módulo {moduleNumber}</span>
      </nav>

      <div class="flex items-center gap-2">
        {duration && (
          <span class="inline-flex items-center gap-1 text-xs text-slate-400 bg-slate-800/80 px-2.5 py-1 rounded-full border border-slate-700/50">
            <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            {duration}
          </span>
        )}

        <span
          id="moduleHeaderBadge"
          class="text-xs font-semibold px-2.5 py-1 rounded-full bg-slate-800 text-slate-300 border border-slate-700 transition-colors"
          data-module-id={id}
        >
          Pendiente
        </span>
      </div>
    </div>

    <!-- Header del Módulo -->
    <header class="border-b-2 border-n8n pb-6 mb-8">
      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-100 tracking-tight mb-3">
        {title}
      </h1>
      <p class="text-base sm:text-lg text-slate-400 leading-relaxed">
        {description}
      </p>
    </header>

    <!-- Contenido en Formato Prose Amigable -->
    <div class="prose prose-invert prose-slate max-w-none text-slate-300">
      <slot />
    </div>

    <!-- Navegación Inferior (Anterior / Siguiente) -->
    <nav class="mt-16 pt-8 border-t border-slate-800 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4">
      {prevModule ? (
        <a
          href={`/modulos/${prevModule.id}`}
          class="flex items-center gap-3 p-4 rounded-xl bg-slate-900 border border-slate-800 hover:border-slate-700 hover:bg-slate-800/80 transition-all text-left group"
        >
          <div class="w-8 h-8 rounded-lg bg-slate-800 flex items-center justify-center text-slate-400 group-hover:text-white transition-colors">
            ←
          </div>
          <div>
            <span class="block text-[11px] uppercase tracking-wider text-slate-500 font-bold">Módulo Anterior</span>
            <span class="text-sm font-semibold text-slate-200 group-hover:text-n8n transition-colors">{prevModule.title}</span>
          </div>
        </a>
      ) : <div />}

      {nextModule ? (
        <a
          href={`/modulos/${nextModule.id}`}
          class="flex items-center justify-between gap-3 p-4 rounded-xl bg-slate-900 border border-slate-800 hover:border-slate-700 hover:bg-slate-800/80 transition-all text-right group ml-auto"
        >
          <div>
            <span class="block text-[11px] uppercase tracking-wider text-slate-500 font-bold">Siguiente Módulo</span>
            <span class="text-sm font-semibold text-slate-200 group-hover:text-n8n transition-colors">{nextModule.title}</span>
          </div>
          <div class="w-8 h-8 rounded-lg bg-n8n/10 flex items-center justify-center text-n8n group-hover:bg-n8n group-hover:text-white transition-colors">
            →
          </div>
        </a>
      ) : (
        <a
          href="/"
          class="flex items-center justify-between gap-3 p-4 rounded-xl bg-emerald-950/30 border border-emerald-800/50 hover:bg-emerald-950/50 transition-all text-right group ml-auto"
        >
          <div>
            <span class="block text-[11px] uppercase tracking-wider text-emerald-400 font-bold">Fin de la Ruta</span>
            <span class="text-sm font-semibold text-slate-200">Volver al Inicio 🎉</span>
          </div>
          <div class="w-8 h-8 rounded-lg bg-emerald-500/20 flex items-center justify-center text-emerald-400">
            ✓
          </div>
        </a>
      )}
    </nav>
  </article>
</BaseLayout>

<script>
  import { getProgress, PROGRESS_EVENT } from '@/scripts/progress';

  const badge = document.getElementById('moduleHeaderBadge');
  const moduleId = badge?.getAttribute('data-module-id');

  function updateBadge() {
    if (!badge || !moduleId) return;
    const progress = getProgress();
    if (progress[moduleId]) {
      badge.textContent = 'Completado ✓';
      badge.className =
        'text-xs font-semibold px-3 py-1 rounded-full bg-emerald-950/80 text-emerald-400 border border-emerald-700/50 shadow-sm';
    } else {
      badge.textContent = 'En Progreso';
      badge.className =
        'text-xs font-semibold px-3 py-1 rounded-full bg-amber-950/60 text-amber-400 border border-amber-800/50';
    }
  }

  window.addEventListener(PROGRESS_EVENT, updateBadge);
  updateBadge();
</script>
