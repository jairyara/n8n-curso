---
interface Block {
  id: string;
  text: string;
}

interface Level {
  id: number;
  name: string;
  scenario: string;
  blocks: Block[];
  correctOrder: string[];
}

interface Props {
  moduleId: string;
  title: string;
  subtitle: string;
  introText?: string;
  levels: Level[];
}

const {
  moduleId,
  title,
  subtitle,
  introText = 'Ordena los bloques en la secuencia lógica correcta según la regla de oro: Disparador ➔ Condición ➔ Camino Sí ➔ Camino No ➔ Acción Final.',
  levels,
} = Astro.props;

const gameInstanceId = `seq-game-${moduleId}`;
---

<div
  id={gameInstanceId}
  class="my-12 rounded-2xl bg-brand-surface border border-slate-800 p-6 sm:p-8 shadow-2xl relative overflow-hidden"
  data-module-id={moduleId}
  data-levels={JSON.stringify(levels)}
>
  <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-n8n via-sky-500 to-emerald-500"></div>

  <!-- Pantalla 0: Introducción -->
  <div class="game-screen screen-intro text-center py-4">
    <span class="inline-block px-3 py-1 rounded-full bg-n8n/10 text-n8n text-xs font-bold uppercase tracking-wider mb-3">
      Reto Interactivo
    </span>
    <h3 class="text-2xl sm:text-3xl font-black text-slate-100 mb-2">
      {title}
    </h3>
    <p class="text-slate-400 max-w-xl mx-auto text-sm sm:text-base mb-6">
      {subtitle}
    </p>
    <div class="bg-slate-900/80 border border-slate-800 rounded-xl p-4 max-w-lg mx-auto mb-8 text-left text-xs sm:text-sm text-slate-300">
      <p class="font-semibold text-sky-400 mb-1">💡 Regla de Oro:</p>
      <p>{introText}</p>
    </div>
    <button
      type="button"
      class="btn-start-game px-8 py-3.5 rounded-xl bg-n8n text-white font-bold text-sm sm:text-base hover:bg-n8n-hover shadow-lg shadow-n8n/25 hover:scale-105 active:scale-95 transition-all cursor-pointer"
    >
      Comenzar Evaluación
    </button>
  </div>

  <!-- Pantalla Dinámica de Nivel -->
  <div class="game-screen screen-level hidden">
    <!-- Indicador de Progreso del Juego -->
    <div class="flex items-center justify-between border-b border-slate-800 pb-4 mb-6">
      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-n8n block">
          Nivel <span class="current-level-num">1</span> de {levels.length}
        </span>
        <h4 class="current-level-title text-lg font-bold text-slate-100">
          Reto
        </h4>
      </div>

      <div class="flex items-center gap-1.5 level-dots-container">
        {levels.map((_, idx) => (
          <div
            class="level-dot w-2.5 h-2.5 rounded-full bg-slate-700 transition-all duration-300"
            data-dot-index={idx}
          />
        ))}
      </div>
    </div>

    <p class="current-level-scenario text-sm text-slate-300 mb-6 bg-slate-900/60 p-4 rounded-xl border border-slate-800/80">
      Escenario
    </p>

    <!-- Opciones de Bloques -->
    <div>
      <p class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">
        Bloques Disponibles (Haz clic en el orden correcto):
      </p>
      <div class="grid grid-cols-1 gap-2.5 options-container mb-6"></div>
    </div>

    <!-- Área de Secuencia Ordenada -->
    <div>
      <p class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">
        Tu Secuencia Construida:
      </p>
      <div class="min-h-[140px] rounded-xl border-2 border-dashed border-slate-700 bg-slate-950/50 p-3 sm:p-4 flex flex-col gap-2 sequence-container">
        <p class="sequence-empty-placeholder text-xs text-slate-500 italic text-center my-auto">
          Haz clic en los bloques superiores para añadirlos a la secuencia...
        </p>
      </div>
    </div>

    <!-- Mensaje de Feedback -->
    <div class="feedback-msg min-h-[30px] my-4 text-sm font-semibold text-center transition-all"></div>

    <!-- Controles -->
    <div class="flex flex-wrap items-center justify-between gap-3 pt-4 border-t border-slate-800">
      <button
        type="button"
        class="btn-reset-level px-4 py-2 text-xs sm:text-sm font-semibold text-slate-400 hover:text-white rounded-lg hover:bg-slate-800 border border-slate-700/60 transition-colors"
      >
        ↺ Deshacer Todo
      </button>

      <button
        type="button"
        class="btn-next-level hidden px-6 py-2.5 text-xs sm:text-sm font-bold text-white bg-emerald-600 hover:bg-emerald-500 rounded-lg shadow-md shadow-emerald-900/50 transition-all cursor-pointer"
      >
        Continuar al Siguiente Nivel →
      </button>
    </div>
  </div>

  <!-- Pantalla Final: ¡Felicidades! -->
  <div class="game-screen screen-success hidden text-center py-6">
    <div class="w-16 h-16 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center text-3xl mx-auto mb-4 border border-emerald-500/30">
      🎉
    </div>
    <h3 class="text-2xl sm:text-3xl font-black text-slate-100 mb-2">
      ¡Módulo Aprobado!
    </h3>
    <p class="text-slate-300 max-w-md mx-auto text-sm sm:text-base mb-6">
      Has ordenado con éxito todas las secuencias lógicas. Tu progreso ha sido registrado y el módulo se encuentra completado.
    </p>
    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-950/60 border border-emerald-700/50 text-emerald-400 text-xs font-semibold mb-6">
      <span>✓ Registrado en LocalStorage</span>
    </div>
    <div class="block">
      <button
        type="button"
        class="btn-restart-game px-6 py-2.5 text-xs sm:text-sm font-semibold text-slate-400 hover:text-white rounded-lg hover:bg-slate-800 border border-slate-700 transition-colors"
      >
        Volver a Repasar el Reto
      </button>
    </div>
  </div>
</div>

<script>
  import { setModuleCompleted } from '@/scripts/progress';

  interface Block {
    id: string;
    text: string;
  }

  interface Level {
    id: number;
    name: string;
    scenario: string;
    blocks: Block[];
    correctOrder: string[];
  }

  function initSequenceGames() {
    const gameWrappers = document.querySelectorAll('[id^="seq-game-"]');

    gameWrappers.forEach((wrapper) => {
      const moduleId = wrapper.getAttribute('data-module-id') || '';
      const rawLevels = wrapper.getAttribute('data-levels');
      const levels: Level[] = rawLevels ? JSON.parse(rawLevels) : [];
      if (!levels.length) return;

      const introScreen = wrapper.querySelector('.screen-intro') as HTMLElement;
      const levelScreen = wrapper.querySelector('.screen-level') as HTMLElement;
      const successScreen = wrapper.querySelector('.screen-success') as HTMLElement;

      const btnStart = wrapper.querySelector('.btn-start-game');
      const btnReset = wrapper.querySelector('.btn-reset-level');
      const btnNext = wrapper.querySelector('.btn-next-level') as HTMLElement;
      const btnRestart = wrapper.querySelector('.btn-restart-game');

      const titleEl = wrapper.querySelector('.current-level-title');
      const numEl = wrapper.querySelector('.current-level-num');
      const scenarioEl = wrapper.querySelector('.current-level-scenario');
      const optionsContainer = wrapper.querySelector('.options-container') as HTMLElement;
      const sequenceContainer = wrapper.querySelector('.sequence-container') as HTMLElement;
      const feedbackEl = wrapper.querySelector('.feedback-msg') as HTMLElement;
      const dots = wrapper.querySelectorAll('.level-dot');

      let currentLevelIndex = 0;
      let currentSequence: string[] = [];

      function showScreen(screen: 'intro' | 'level' | 'success') {
        introScreen.classList.add('hidden');
        levelScreen.classList.add('hidden');
        successScreen.classList.add('hidden');

        if (screen === 'intro') introScreen.classList.remove('hidden');
        if (screen === 'level') levelScreen.classList.remove('hidden');
        if (screen === 'success') successScreen.classList.remove('hidden');
      }

      function updateDots() {
        dots.forEach((dot, idx) => {
          if (idx === currentLevelIndex) {
            dot.className = 'level-dot w-3 h-3 rounded-full bg-n8n shadow-md shadow-n8n/50';
          } else if (idx < currentLevelIndex) {
            dot.className = 'level-dot w-2.5 h-2.5 rounded-full bg-emerald-500';
          } else {
            dot.className = 'level-dot w-2.5 h-2.5 rounded-full bg-slate-700';
          }
        });
      }

      function renderCurrentLevel() {
        const level = levels[currentLevelIndex];
        currentSequence = [];

        if (numEl) numEl.textContent = String(currentLevelIndex + 1);
        if (titleEl) titleEl.textContent = level.name;
        if (scenarioEl) scenarioEl.textContent = level.scenario;

        updateDots();

        // Limpiar feedback y botón siguiente
        if (feedbackEl) {
          feedbackEl.textContent = '';
          feedbackEl.className = 'feedback-msg min-h-[30px] my-4 text-sm font-semibold text-center transition-all';
        }
        btnNext.classList.add('hidden');

        // Limpiar secuencia
        sequenceContainer.innerHTML =
          '<p class="sequence-empty-placeholder text-xs text-slate-500 italic text-center my-auto">Haz clic en los bloques superiores para añadirlos a la secuencia...</p>';

        // Renderizar opciones
        optionsContainer.innerHTML = '';
        level.blocks.forEach((block) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className =
            'block-choice w-full text-left p-3 sm:p-3.5 rounded-xl bg-slate-800 hover:bg-slate-750 border border-slate-700 hover:border-sky-500/50 text-slate-200 text-xs sm:text-sm font-medium transition-all hover:translate-x-1 cursor-pointer flex items-center gap-2.5';
          btn.setAttribute('data-block-id', block.id);
          btn.innerHTML = `<span class="w-2 h-2 rounded-full bg-sky-400 shrink-0"></span><span>${block.text}</span>`;

          btn.addEventListener('click', () => {
            selectBlock(block, btn, level);
          });

          optionsContainer.appendChild(btn);
        });
      }

      function selectBlock(block: Block, btnElement: HTMLElement, level: Level) {
        if (currentSequence.length >= level.correctOrder.length) return;

        // Ocultar placeholder
        const placeholder = sequenceContainer.querySelector('.sequence-empty-placeholder');
        if (placeholder) placeholder.remove();

        currentSequence.push(block.id);
        btnElement.classList.add('opacity-30', 'pointer-events-none', 'scale-98');

        // Crear item en secuencia
        const stepNum = currentSequence.length;
        const seqItem = document.createElement('div');
        seqItem.className =
          'sequence-item p-3 rounded-lg bg-sky-500/10 border border-sky-500/30 text-sky-200 text-xs sm:text-sm font-medium flex items-center gap-2.5 animate-pop-in';
        seqItem.innerHTML = `<span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-sky-500 text-[10px] font-black text-slate-950">${stepNum}</span><span>${block.text}</span>`;
        sequenceContainer.appendChild(seqItem);

        // Si ya seleccionó todos los bloques, validar
        if (currentSequence.length === level.correctOrder.length) {
          validateSequence(level);
        }
      }

      function validateSequence(level: Level) {
        const isCorrect = JSON.stringify(currentSequence) === JSON.stringify(level.correctOrder);

        if (isCorrect) {
          feedbackEl.textContent = '¡Excelente! El orden lógico es perfecto. ✅';
          feedbackEl.className = 'feedback-msg min-h-[30px] my-4 text-sm font-bold text-center text-emerald-400';

          if (currentLevelIndex < levels.length - 1) {
            btnNext.textContent = 'Ir al Siguiente Reto →';
            btnNext.classList.remove('hidden');
          } else {
            // Último nivel completado: registrar en localStorage
            setModuleCompleted(moduleId, true);
            btnNext.textContent = 'Finalizar y Completar Módulo 🎉';
            btnNext.classList.remove('hidden');
          }
        } else {
          feedbackEl.textContent =
            'La secuencia no es la más lógica. Revisa el orden causa-efecto y pulsa "Deshacer Todo" para intentar de nuevo. ❌';
          feedbackEl.className = 'feedback-msg min-h-[30px] my-4 text-sm font-bold text-center text-rose-400';
        }
      }

      function resetCurrentLevel() {
        renderCurrentLevel();
      }

      btnStart?.addEventListener('click', () => {
        currentLevelIndex = 0;
        showScreen('level');
        renderCurrentLevel();
      });

      btnReset?.addEventListener('click', resetCurrentLevel);

      btnNext?.addEventListener('click', () => {
        if (currentLevelIndex < levels.length - 1) {
          currentLevelIndex++;
          renderCurrentLevel();
        } else {
          showScreen('success');
        }
      });

      btnRestart?.addEventListener('click', () => {
        currentLevelIndex = 0;
        showScreen('intro');
      });
    });
  }

  initSequenceGames();
</script>
