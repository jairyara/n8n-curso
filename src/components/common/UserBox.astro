---
---

<div class="rounded-xl bg-slate-900/90 border border-slate-800 p-4 shadow-sm mb-6">
  <div class="flex items-center justify-between mb-1.5">
    <span class="text-[11px] font-bold uppercase tracking-wider text-n8n">
      Usuario Activo
    </span>
    <span id="userStatusDot" class="inline-block w-2 h-2 rounded-full bg-slate-500"></span>
  </div>

  <p id="userEmailDisplay" class="text-sm font-medium text-slate-300 truncate" title="Sin sesión iniciada">
    Estudiante Invitado
  </p>

  <button
    id="btnTriggerEmailModal"
    type="button"
    class="mt-3 w-full rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold py-2 px-3 border border-slate-700 transition-colors flex items-center justify-center gap-1.5"
  >
    <svg class="w-3.5 h-3.5 text-n8n" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
    </svg>
    <span id="btnTriggerText">Identificarse</span>
  </button>
</div>

<script>
  import { getUserEmail, PROGRESS_EVENT } from '@/scripts/progress';

  const emailDisplay = document.getElementById('userEmailDisplay');
  const statusDot = document.getElementById('userStatusDot');
  const triggerBtn = document.getElementById('btnTriggerEmailModal');
  const triggerText = document.getElementById('btnTriggerText');

  function renderUser() {
    const email = getUserEmail();
    if (email) {
      if (emailDisplay) {
        emailDisplay.textContent = email;
        emailDisplay.title = email;
      }
      if (statusDot) {
        statusDot.className = 'inline-block w-2 h-2 rounded-full bg-emerald-500';
      }
      if (triggerText) {
        triggerText.textContent = 'Cambiar Correo';
      }
    } else {
      if (emailDisplay) {
        emailDisplay.textContent = 'Estudiante Invitado';
        emailDisplay.title = 'Progreso guardado localmente';
      }
      if (statusDot) {
        statusDot.className = 'inline-block w-2 h-2 rounded-full bg-amber-500';
      }
      if (triggerText) {
        triggerText.textContent = 'Identificarse';
      }
    }
  }

  triggerBtn?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('n8n:open-email-modal'));
  });

  window.addEventListener(PROGRESS_EVENT, renderUser);
  renderUser();
</script>
