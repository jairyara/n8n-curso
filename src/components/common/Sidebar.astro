---
import { getCollection } from 'astro:content';
import UserBox from './UserBox.astro';
import ProgressBar from './ProgressBar.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

// Obtener módulos ordenados de las Content Collections
const modules = await getCollection('modules');
modules.sort((a, b) => a.data.moduleNumber - b.data.moduleNumber);
const moduleIds = modules.map((m) => m.data.id);
---

<!-- Overlay para cerrar sidebar en pantallas móviles -->
<div
  id="sidebarOverlay"
  class="fixed inset-0 z-40 bg-slate-950/70 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300 lg:hidden"
  aria-hidden="true"
></div>

<!-- Barra Lateral (Desktop fija, Mobile drawer) -->
<aside
  id="appSidebar"
  class="fixed top-0 left-0 bottom-0 z-50 w-72 bg-brand-sidebar border-r border-slate-800 flex flex-col justify-between -translate-x-full lg:translate-x-0 transition-transform duration-300 ease-in-out shadow-2xl lg:shadow-none overflow-y-auto"
>
  <div class="p-5">
    <!-- Header de la Barra -->
    <div class="flex items-center justify-between pb-5 border-b border-slate-800/80 mb-5">
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-n8n to-amber-500 flex items-center justify-center text-white font-black text-xl shadow-lg shadow-n8n/20 group-hover:scale-105 transition-transform">
          ⚡
        </div>
        <div>
          <span class="block font-black text-slate-100 text-lg tracking-tight group-hover:text-n8n transition-colors">
            OVA n8n
          </span>
          <span class="block text-[11px] text-slate-400 font-medium -mt-0.5">
            Semillero ETITC 2026
          </span>
        </div>
      </a>

      <!-- Botón de Cerrar en móvil -->
      <button
        id="closeSidebarBtn"
        type="button"
        class="lg:hidden p-2 text-slate-400 hover:text-white rounded-lg hover:bg-slate-800 transition-colors"
        aria-label="Cerrar barra lateral"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Identificación de Usuario -->
    <UserBox />

    <!-- Barra de Progreso Global -->
    <ProgressBar moduleIds={moduleIds} />

    <!-- Menú de Navegación -->
    <nav class="space-y-1">
      <div class="text-[11px] font-bold uppercase tracking-wider text-slate-500 px-3 mb-2">
        Navegación
      </div>

      <a
        href="/"
        class:list={[
          'flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all group',
          currentPath === '/'
            ? 'bg-slate-800/90 text-white font-semibold shadow-inner border border-slate-700/50'
            : 'text-slate-400 hover:text-slate-200 hover:bg-slate-800/50',
        ]}
      >
        <span class="text-base">📌</span>
        <span class="flex-grow">Inicio / Menú</span>
      </a>

      {
        modules.map((module) => {
          const href = `/modulos/${module.data.id}`;
          const isActive = currentPath === href || currentPath.startsWith(`${href}/`);

          return (
            <a
              href={href}
              class:list={[
                'flex items-center justify-between gap-2 px-3 py-2.5 rounded-xl text-sm font-medium transition-all group',
                isActive
                  ? 'bg-slate-800/90 text-white font-semibold shadow-inner border border-slate-700/50'
                  : 'text-slate-400 hover:text-slate-200 hover:bg-slate-800/50',
              ]}
            >
              <div class="flex items-center gap-2.5 truncate">
                <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-slate-800 text-[10px] font-bold text-slate-300 group-hover:bg-n8n group-hover:text-white transition-colors">
                  {module.data.moduleNumber}
                </span>
                <span class="truncate">{module.data.shortTitle}</span>
              </div>

              <span
                class="module-status-badge shrink-0 text-[10px] font-semibold px-2 py-0.5 rounded-full bg-slate-800 text-slate-400 border border-slate-700 transition-colors"
                data-module-id={module.data.id}
              >
                Pendiente
              </span>
            </a>
          );
        })
      }
    </nav>
  </div>

  <div class="p-5 border-t border-slate-800/80 text-center">
    <p class="text-[11px] text-slate-500">
      Virtual Aprende &copy; ETITC 2026
    </p>
    <p class="text-[10px] text-slate-600 mt-0.5">
      Automatización de Procesos
    </p>
  </div>
</aside>

<script>
  import { getProgress, PROGRESS_EVENT } from '@/scripts/progress';

  // Toggle de Sidebar Móvil
  const sidebar = document.getElementById('appSidebar');
  const overlay = document.getElementById('sidebarOverlay');
  const closeBtn = document.getElementById('closeSidebarBtn');

  function openSidebar() {
    sidebar?.classList.remove('-translate-x-full');
    overlay?.classList.remove('opacity-0', 'pointer-events-none');
    overlay?.classList.add('opacity-100');
  }

  function closeSidebar() {
    sidebar?.classList.add('-translate-x-full');
    overlay?.classList.add('opacity-0', 'pointer-events-none');
    overlay?.classList.remove('opacity-100');
  }

  window.addEventListener('n8n:toggle-sidebar', () => {
    if (sidebar?.classList.contains('-translate-x-full')) {
      openSidebar();
    } else {
      closeSidebar();
    }
  });

  overlay?.addEventListener('click', closeSidebar);
  closeBtn?.addEventListener('click', closeSidebar);

  // Actualizar badges de estado de cada módulo
  function updateBadges() {
    const progress = getProgress();
    const badges = document.querySelectorAll('.module-status-badge');

    badges.forEach((badge) => {
      const moduleId = badge.getAttribute('data-module-id');
      if (moduleId && progress[moduleId]) {
        badge.textContent = 'Completado';
        badge.className =
          'module-status-badge shrink-0 text-[10px] font-semibold px-2 py-0.5 rounded-full bg-emerald-950/80 text-emerald-400 border border-emerald-700/50 shadow-sm shadow-emerald-950';
      } else {
        badge.textContent = 'Pendiente';
        badge.className =
          'module-status-badge shrink-0 text-[10px] font-semibold px-2 py-0.5 rounded-full bg-slate-800 text-slate-400 border border-slate-700';
      }
    });
  }

  window.addEventListener(PROGRESS_EVENT, updateBadges);
  updateBadges();
</script>
